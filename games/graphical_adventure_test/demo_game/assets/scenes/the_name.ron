(
  steps: [
    Background("backgrounds/mountains.webp"),
    // Every scene stages its own cast: a scene is entered by several routes, and
    // a phase change clears the stage. Inheriting whoever happened to be on
    // screen renders correctly down one path and empty down the others.
    Show(character: "mira", slot: Left),
    Show(character: "golem", slot: Right),
    Set("carries_name"),
    Music(Some("music/calm.ogg")),

    Say(speaker: "golem", text: r#"You would carry it? It is heavy, and it is not a kind thing to know."#),
    Say(speaker: "mira", text: r#"I've carried worse up this mountain. Try me."#),

    Narrate(r#"He tells her. It takes some time, and it is not a word in any language she has met."#),

    Say(speaker: "mira", text: r#"...That's it? That's the whole thing?"#),
    Say(speaker: "golem", text: r#"That is the whole thing. Six hundred years, and it took eleven seconds to hand over."#),

    JumpTo("mending"),
  ],
)
