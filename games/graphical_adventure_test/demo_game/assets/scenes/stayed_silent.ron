(
  steps: [
    Background("backgrounds/mountains.webp"),
    // Every scene stages its own cast: a scene is entered by several routes, and
    // a phase change clears the stage. Inheriting whoever happened to be on
    // screen renders correctly down one path and empty down the others.
    Show(character: "mira", slot: Left),
    Show(character: "golem", slot: Right),
    Narrate(r#"You keep your mouth shut and your eyes on the machinery: a lattice of gold wheels, most of them still, one of them bent badly out of true."#),

    Say(speaker: "golem", text: r#"Careful. Staring is its own kind of demand."#),
    Say(speaker: "mira", text: r#"..."#),
    Say(speaker: "golem", text: r#"As you like. Silence keeps well up here. Everything does."#),

    JumpTo("the_offer"),
  ],
)
