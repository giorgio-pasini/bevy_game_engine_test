(
  steps: [
    Background("backgrounds/mountains.webp"),
    // Mira alone: he is carrying her, not standing beside her. Jumped to from
    // `ending_carried`, which replaces the frame — so its staging is gone and
    // this scene has to say what it wants on screen.
    Show(character: "mira", slot: Left),
    Narrate(r#"She says the name once, near the summit, mostly to check that she still has it. The wind takes it and gives nothing back."#),
    Narrate(r#"Below the pass she stops counting the winters he told her about, and starts counting the ones ahead. It is a better arithmetic, and it is his now as much as hers."#),

    End,
  ],
)
