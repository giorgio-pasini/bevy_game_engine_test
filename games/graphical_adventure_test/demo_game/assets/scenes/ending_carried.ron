(
  steps: [
    Background("backgrounds/mountains.webp"),
    // Staged, then cleared: the `Hide` is only meaningful over a cast this scene
    // established itself. Relying on the previous scene's staging made him
    // vanish or linger depending on the route taken here.
    Show(character: "mira", slot: Left),
    Show(character: "golem", slot: Right),
    Hide(slot: Right),

    Narrate(r#"He carries her over the peaks by morning, exactly as promised."#),

    // Flags set several scenes ago change how this lands.
    JumpIf(condition: IsSet("carries_name"), target: "ending_carried_name"),

    Narrate(r#"Neither of them says anything about the winters. Below the pass the map starts agreeing with the mountain again, which Mira decides not to mention."#),

    End,
  ],
)
