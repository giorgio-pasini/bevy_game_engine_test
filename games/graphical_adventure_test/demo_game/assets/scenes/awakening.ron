// Scene id = filename. Every path, jump target, cast id and flag below is
// checked by build.rs — mistakes fail `cargo build`, not the playthrough.
(
  steps: [
    Background("backgrounds/mountains.webp"),
    Music(Some("music/mystery.ogg")),

    Narrate(r#"Three days up the pass, and the mountain has not once looked back at you."#),

    Show(character: "mira", slot: Left),

    Say(speaker: "mira", text: r#"Right. Either that ridge moved, or I've been walking in a circle since noon."#),

    Narrate(r#"Then the cloud parts — and something vast turns its head."#),

    Show(character: "golem", slot: Right),

    Say(speaker: "golem", text: r#"You are small. And you are late."#),
    Say(speaker: "mira", text: r#"...Late for what, exactly?"#),
    Say(speaker: "golem", text: r#"I have been counting winters since anyone last climbed this far. Six hundred and eleven. You are late by all of them."#),

    JumpTo("introductions"),
  ],
)
