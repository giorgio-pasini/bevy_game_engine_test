(
  steps: [
    Background("backgrounds/golem_05.jpg"),

    Say(
      speaker: "The Golden Golem",
      text: r#"There is work in me that has gone unfinished for six hundred years. Gears that no longer turn. A name I can no longer pronounce."#,
    ),
    Say(
      speaker: "The Golden Golem",
      text: r#"Mend me, and I will carry you over the peaks by morning. Refuse, and I will let you pass — but you will walk, and the walking is long."#,
    ),

    Choices([
      (text: r#"Reach for the seized gear in his chest."#, target: "accept"),
      (text: r#"Step back, and keep your hands to yourself."#, target: "refuse"),
    ]),
  ],
)
