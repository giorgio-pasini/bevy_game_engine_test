(
  steps: [
    Background("backgrounds/mountains.webp"),
    // Every scene stages its own cast: a scene is entered by several routes, and
    // a phase change clears the stage. Inheriting whoever happened to be on
    // screen renders correctly down one path and empty down the others.
    Show(character: "mira", slot: Left),
    Show(character: "golem", slot: Right),
    Set("knows_name"),
    Add(flag: "trust", delta: 2),

    Say(speaker: "mira", text: r#"Mira. And I'm not demanding anything — I'd just like to know what I'm looking at."#),
    Say(speaker: "golem", text: r#"Mira."#),
    Narrate(r#"He says it slowly, the way you'd handle something you were afraid of dropping."#),
    Say(speaker: "golem", text: r#"Good. A name is a thing that can be given back later."#),

    JumpTo("the_offer"),
  ],
)
