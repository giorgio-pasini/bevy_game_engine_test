(
  steps: [
    Music(None),

    Say(
      speaker: "The Golden Golem",
      text: r#"Wise. Cowardly, but wise indeed. Not every hand that opens me means to close me again."#,
    ),

    Hide(slot: Centre),

    Narrate(r#"The storm swallows him as you pass. You walk. The walking is long, and you are alone with the sound of your own gears."#),

    End,
  ],
)
